#include <windows.h>

1 RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/src/app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @MPG_VERSION_COMMA@,0
 PRODUCTVERSION @MPG_VERSION_COMMA@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Eyad / Eabusham2\0"
   VALUE "FileDescription", "MaxPrioGames - native game priority manager\0"
   VALUE "FileVersion", "@MPG_VERSION@\0"
   VALUE "InternalName", "MaxPrioGames\0"
   VALUE "LegalCopyright", "Copyright (c) 2026 Eyad\0"
   VALUE "OriginalFilename", "MaxPrioGames.exe\0"
   VALUE "ProductName", "MaxPrioGames\0"
   VALUE "ProductVersion", "@MPG_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
